# NOTE: normal installs don't need this file - first_run_config.py generates
# backend/.env automatically the first time start_server.bat/.sh runs, by
# asking a few plain questions instead of requiring manual editing. This
# file is kept only as a reference for advanced/manual configuration.
APP_NAME=Dispatch Controller
ENV=production

# Central company Postgres - one shared database, per spec.
DATABASE_URL=postgresql+psycopg2://dispatch:CHANGE_ME@localhost:5432/dispatch_controller

SECRET_KEY=CHANGE-ME-TO-A-LONG-RANDOM-STRING
ACCESS_TOKEN_EXPIRE_MINUTES=720

IMPORT_FOLDER=./data/imports
EXPORT_FOLDER=./data/exports
BACKUP_FOLDER=./data/backups
